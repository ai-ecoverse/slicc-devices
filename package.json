{
  "name": "@ai-ecoverse/slicc-devices",
  "version": "0.0.0",
  "description": "serial, usb, hid and ble for SLICC, through seven's page and the browser's device APIs",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-devices.git"
  },
  "engines": {
    "node": ">=24",
    "slicc-kernel": ">=1.176.0"
  },
  "exports": {
    "./page": "./page/index.mjs",
    "./package.json": "./package.json"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-devices",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "slicc": {
    "commands": {
      "serial": {
        "abi": "js",
        "module": "bin/serial.mjs",
        "env": {
          "SLICC_PACKAGE": "${package}"
        }
      },
      "esptool": {
        "abi": "js",
        "module": "bin/esptool.mjs",
        "env": {
          "SLICC_PACKAGE": "${package}"
        }
      }
    },
    "unitSources": [
      "bin",
      "page"
    ]
  },
  "files": [
    "bin",
    "page"
  ],
  "scripts": {
    "prepare": "slicc-install-hooks",
    "lint": "slicc-lint",
    "format": "biome check --write .",
    "test": "node --test --test-timeout=120000 test/integration/*.test.mjs",
    "test:unit": "mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "build": "npm pack --dry-run",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-cdp": "1.48.2",
    "@ai-ecoverse/slicc-kernel": "1.179.0",
    "@ai-ecoverse/slicc-shared-web": "2.14.2",
    "@ai-ecoverse/wasm-bash": "5.3.0-23",
    "@ai-ecoverse/wasm-coreutils": "9.12.0-15",
    "@biomejs/biome": "2.6.5",
    "lefthook": "2.2.2",
    "monocart-coverage-reports": "3.2.0",
    "semantic-release": "25.0.9"
  },
  "dependencies": {
    "esptool-js": "0.7.1"
  }
}
